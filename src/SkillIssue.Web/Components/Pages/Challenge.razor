@page "/challenge/{BugId:int}"
@attribute [Authorize]
@inject IChallengeService ChallengeService
@inject IAttemptService AttemptService
@inject IGitHubVerificationService VerificationService
@inject IForkSubmissionLimiter ForkLimiter

<PageTitle>@(bug?.Title ?? "Challenge") — Skill Issue</PageTitle>

@if (!_loaded)
{
    <p style="color: var(--t3); font-family: var(--mono); font-size: 13px;">Loading...</p>
}
else if (bug is null)
{
    <div class="welcome-pane">
        <div class="welcome-inner">
            <p style="font-family: var(--mono); font-size: 10px; letter-spacing: 1.4px; text-transform: uppercase; color: var(--t3); margin-bottom: 8px;" aria-hidden="true">404</p>
            <h1 class="challenge-h1">Challenge not found</h1>
            <p class="welcome-sub">This challenge doesn&rsquo;t exist or has been removed.</p>
            <a href="/" class="btn btn-outline-secondary">&larr; Back to challenges</a>
        </div>
    </div>
}
else
{
    <nav class="crumb" aria-label="Breadcrumb">
        <a href="/">Challenges</a> &rsaquo; @bug.Repo.Name
    </nav>
    <p class="repo-byline">
        <code class="repo-lang">@bug.Repo.Language</code>@bug.Repo.Description
    </p>

    <div class="challenge-head">
        <div>
            <h1 class="challenge-h1">@bug.Title</h1>
            <div class="challenge-badges">
                <DifficultyDots Level="bug.Difficulty" Badge="true" ShowLabel="true" />
            </div>
        </div>
        <a href="@bug.Repo.GitHubUrl" target="_blank" rel="noopener noreferrer"
           class="btn btn-sm btn-outline-secondary" style="white-space: nowrap;">
            View repo <span aria-hidden="true">&#8599;</span>
            <span class="visually-hidden">(opens in new tab)</span>
        </a>
    </div>

    <section class="challenge-section" aria-labelledby="section-brief">
        <h2 class="sec-label" id="section-brief">What&rsquo;s broken</h2>
        <p class="brief-text">@bug.Brief</p>
    </section>

    <section class="challenge-section" aria-label="Error and failing tests">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
            <div class="code-panel" style="margin-bottom: 0;">
                <div class="code-panel-head">
                    <span class="code-panel-tag err" aria-label="Failing output">&#9747; Failing output</span>
                </div>
                <div class="code-panel-body">
                    <pre>@bug.ErrorMessage</pre>
                </div>
            </div>
            <div class="code-panel" style="margin-bottom: 0;">
                <div class="code-panel-head">
                    <span class="code-panel-tag">Failing tests</span>
                </div>
                <div class="code-panel-body">
                    @foreach (var t in bug.FailingTests.Select(f => f.TestName))
                    {
                        <code>@t</code>
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="challenge-section" aria-labelledby="section-hints">
        <h2 class="sec-label" id="section-hints">Hints</h2>
        <p class="hint-tally">@revealedCount / @bug.Hints.Count revealed &mdash; fewer hints used = cleaner result</p>

        @foreach (var hint in bug.Hints.OrderBy(h => h.Order).Take(revealedCount))
        {
            <div class="hint-card">
                <div class="hint-tag">@hint.Label</div>
                <div class="hint-body">@hint.Content</div>
            </div>
        }

        @if (revealedCount < bug.Hints.Count)
        {
            <button class="btn btn-outline-secondary btn-sm" @onclick="RevealHint"
                    aria-label="Reveal hint @(revealedCount + 1): @bug.Hints.OrderBy(h => h.Order).ElementAt(revealedCount).Label">
                Reveal hint @(revealedCount + 1): @bug.Hints.OrderBy(h => h.Order).ElementAt(revealedCount).Label
            </button>
        }
        else
        {
            <span style="font-family: var(--mono); font-size: 11px; color: var(--t3);">All hints revealed.</span>
        }
    </section>

    <section class="terminal-panel" aria-labelledby="tab-terminal">
        <div class="terminal-tabs" role="tablist" aria-label="Terminal panels">
            <button class="terminal-tab-btn @(activeTab == "problems" ? "active" : "")"
                    role="tab"
                    id="tab-problems"
                    aria-selected="@(activeTab == "problems" ? "true" : "false")"
                    aria-controls="panel-problems"
                    tabindex="@(activeTab == "problems" ? 0 : -1)"
                    @ref="tabRefProblems"
                    @onclick='() => ActivateTab("problems")'
                    @onkeydown='e => HandleTabKey(e, "problems")'>Problems</button>
            <button class="terminal-tab-btn @(activeTab == "output" ? "active" : "")"
                    role="tab"
                    id="tab-output"
                    aria-selected="@(activeTab == "output" ? "true" : "false")"
                    aria-controls="panel-output"
                    tabindex="@(activeTab == "output" ? 0 : -1)"
                    @ref="tabRefOutput"
                    @onclick='() => ActivateTab("output")'
                    @onkeydown='e => HandleTabKey(e, "output")'>Output</button>
            <button class="terminal-tab-btn @(activeTab == "terminal" ? "active" : "")"
                    role="tab"
                    id="tab-terminal"
                    aria-selected="@(activeTab == "terminal" ? "true" : "false")"
                    aria-controls="panel-terminal"
                    tabindex="@(activeTab == "terminal" ? 0 : -1)"
                    @ref="tabRefTerminal"
                    @onclick='() => ActivateTab("terminal")'
                    @onkeydown='e => HandleTabKey(e, "terminal")'>Terminal</button>
        </div>

        <div id="panel-problems" role="tabpanel" aria-labelledby="tab-problems"
             class="terminal-body" hidden="@(activeTab != "problems")">
            @foreach (var t in bug.FailingTests.Select(f => f.TestName))
            {
                <div class="problem-item">
                    <span class="code-panel-tag err" aria-hidden="true">&#9747;</span>
                    <code>@t</code>
                </div>
            }
        </div>

        <div id="panel-output" role="tabpanel" aria-labelledby="tab-output"
             class="terminal-body" hidden="@(activeTab != "output")">
            <pre class="output-pre">@bug.ErrorMessage</pre>
        </div>

        <div id="panel-terminal" role="tabpanel" aria-labelledby="tab-terminal"
             class="terminal-body" hidden="@(activeTab != "terminal")">
            <p class="terminal-prompt" aria-hidden="true">
                <span class="prompt-path">~/skill-issue</span>
                <span style="color: var(--t3);"> $ </span>
                <span class="prompt-cmd">submit-fork</span>
            </p>

            <AuthorizeView>
                <Authorized>
                    <ol class="step-list">
                        <li>
                            <span class="step-n" aria-hidden="true">01</span>
                            <span>
                                <a href="@bug.Repo.GitHubUrl/fork" target="_blank" rel="noopener noreferrer">
                                    Fork <strong style="color: var(--t1);">@bug.Repo.Name</strong> on GitHub
                                    <span class="visually-hidden">(opens in new tab)</span>
                                </a>
                            </span>
                        </li>
                        <li>
                            <span class="step-n" aria-hidden="true">02</span>
                            <span>Clone your fork and run <code style="color: var(--gold);">dotnet test</code> to reproduce the failure</span>
                        </li>
                        <li>
                            <span class="step-n" aria-hidden="true">03</span>
                            <span>Find and fix the bug, then push your commit</span>
                        </li>
                        <li>
                            <span class="step-n" aria-hidden="true">04</span>
                            <span>Paste your fork URL below &mdash; the CI run is checked automatically</span>
                        </li>
                    </ol>

                    <label class="form-label" for="fork-url">Your fork URL</label>
                    <input class="form-control mb-3" type="url" id="fork-url"
                           placeholder="https://github.com/your-username/..."
                           autocomplete="url"
                           aria-required="true"
                           aria-describedby="fork-url-result"
                           @bind="forkUrl" @bind:event="oninput" />

                    <div id="fork-url-result" aria-live="polite" aria-atomic="true">
                        @if (submitError is not null)
                        {
                            <div class="result-strip result-err" role="alert">@submitError</div>
                        }

                        @if (verificationResult is not null)
                        {
                            <div class="result-strip @(verificationResult.Passed ? "result-pass" : "result-warn")" role="status">
                                @(verificationResult.Passed ? "✓ PASS" : "✗ NOT YET")
                                &mdash; @verificationResult.Message
                                @if (verificationResult.CommitSha is { Length: >= 7 } sha)
                                {
                                    <span style="color: var(--t3); font-size: 11px; display: block; margin-top: 4px;">
                                        checked commit: @sha[..7]
                                    </span>
                                }
                            </div>
                        }
                    </div>

                    <div style="display: flex; align-items: center; gap: 10px; margin-top: 14px;">
                        <button class="btn btn-primary" @onclick="SubmitFork"
                                disabled="@(isSubmitting || string.IsNullOrWhiteSpace(forkUrl))"
                                aria-busy="@isSubmitting.ToString().ToLower()">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border me-1" role="status" aria-hidden="true"></span>
                                <span>Checking&hellip;</span>
                            }
                            else
                            {
                                <span>Check my fork</span>
                            }
                        </button>

                        @if (verificationResult?.Passed == true)
                        {
                            <a href="/progress" class="btn btn-success">View progress &rarr;</a>
                        }
                    </div>
                </Authorized>
                <NotAuthorized>
                    <p style="font-size: 13px; color: var(--t2);">
                        <a href="/login">Log in with GitHub</a>
                        <span style="color: var(--t3);"> to submit your fix and track progress.</span>
                    </p>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </section>
}

@code {
    [Parameter] public int BugId { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private Bug? bug;
    private bool _loaded;
    private int revealedCount;
    private string forkUrl = "";
    private bool isSubmitting;
    private VerificationResult? verificationResult;
    private string? submitError;
    private DateTime _startedAt;
    private DateTime _lastSubmit = DateTime.MinValue;

    // Terminal tabs
    private string activeTab = "terminal";
    private static readonly string[] TabOrder = ["problems", "output", "terminal"];
    private ElementReference tabRefProblems, tabRefOutput, tabRefTerminal;

    private void ActivateTab(string tab) => activeTab = tab;

    private async Task HandleTabKey(KeyboardEventArgs e, string current)
    {
        var idx = Array.IndexOf(TabOrder, current);
        string? next = e.Key switch {
            "ArrowRight" or "ArrowDown" => TabOrder[(idx + 1) % TabOrder.Length],
            "ArrowLeft"  or "ArrowUp"   => TabOrder[(idx - 1 + TabOrder.Length) % TabOrder.Length],
            "Home"  => TabOrder[0],
            "End"   => TabOrder[^1],
            _ => null
        };
        if (next is null) return;
        activeTab = next;
        var target = next switch {
            "problems" => tabRefProblems,
            "output"   => tabRefOutput,
            _          => tabRefTerminal,
        };
        await target.FocusAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        bug = await ChallengeService.GetBugWithHintsAsync(BugId);
        _startedAt = DateTime.UtcNow;
        _loaded = true;
    }

    private void RevealHint()
    {
        if (bug is not null && revealedCount < bug.Hints.Count)
            revealedCount++;
    }

    private async Task SubmitFork()
    {
        if (bug is null || string.IsNullOrWhiteSpace(forkUrl)) return;

        var state = await AuthState!;
        var userId = state.User.GetUserId();
        if (userId is null) { submitError = "You must be logged in to submit."; return; }

        if (!ForkLimiter.TryAcquire(userId.Value))
        {
            submitError = "Too many attempts. Please wait 30 seconds before trying again.";
            return;
        }

        if (DateTime.UtcNow - _lastSubmit < TimeSpan.FromSeconds(10))
        {
            submitError = "Please wait a moment before submitting again.";
            return;
        }
        _lastSubmit = DateTime.UtcNow;

        isSubmitting = true;
        verificationResult = null;
        submitError = null;

        try
        {
            verificationResult = await VerificationService.VerifyForkAsync(forkUrl, bug.Repo.GitHubUrl);
            var elapsed = (int)(DateTime.UtcNow - _startedAt).TotalSeconds;
            await AttemptService.RecordAttemptAsync(
                userId.Value, bug.Id, forkUrl,
                verificationResult.Passed, revealedCount, elapsed);
        }
        catch (Exception ex)
        {
            submitError = $"Error: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
