@page "/"
@rendermode InteractiveServer
@inject IChallengeService ChallengeService

<PageTitle>Challenges — Skill Issue</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Debugging Challenges</h1>
        <p class="text-muted mb-0">Navigate a real codebase, find the bug, fix it, prove it.</p>
    </div>
</div>

@if (repos is null)
{
    <p class="text-muted">Loading challenges...</p>
}
else if (repos.Count == 0)
{
    <p class="text-muted">No challenges available yet.</p>
}
else
{
    @foreach (var repo in repos)
    {
        <div class="card mb-4 shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <span class="fw-bold fs-5">@repo.Name</span>
                    <span class="badge bg-secondary ms-2">@repo.Language</span>
                </div>
                <a href="@repo.GitHubUrl" target="_blank" rel="noopener noreferrer"
                   class="btn btn-sm btn-outline-secondary">
                    View on GitHub
                </a>
            </div>
            <div class="card-body">
                <p class="card-text text-muted mb-3">@repo.Description</p>
                <div class="list-group list-group-flush">
                    @foreach (var bug in repo.Bugs.OrderBy(b => b.Difficulty))
                    {
                        <a href="/challenge/@bug.Id"
                           class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <span>@bug.Title</span>
                            <span class="badge bg-@DifficultyColor(bug.Difficulty) rounded-pill">
                                @bug.Difficulty
                            </span>
                        </a>
                    }
                </div>
            </div>
        </div>
    }
}

@code {
    private IReadOnlyList<Repo>? repos;

    protected override async Task OnInitializedAsync()
    {
        repos = await ChallengeService.GetActiveReposWithBugsAsync();
    }

    private static string DifficultyColor(Difficulty d) => d switch
    {
        Difficulty.Easy => "success",
        Difficulty.Medium => "warning",
        Difficulty.Hard => "danger",
        _ => "secondary"
    };
}
