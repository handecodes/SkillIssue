@page "/progress"
@attribute [Authorize]
@inject IAttemptService AttemptService
@inject NavigationManager Nav

<PageTitle>My Progress - Skill Issue</PageTitle>

<h1 class="pane-title">My Progress</h1>

@if (_authError)
{
    <div class="welcome-pane">
        <div class="welcome-inner">
            <p style="font-family: var(--mono); font-size: 13px; color: var(--t2);">
                Something went wrong. Please <a href="/login">log in again</a>.
            </p>
        </div>
    </div>
}
else if (summary is null)
{
    <p style="color: var(--text-3); font-family: var(--mono); font-size: 13px;">Loading...</p>
}
else
{
    <div class="stat-grid">
        <div class="stat-card">
            <div class="stat-num">@summary.UniqueSolved</div>
            <div class="stat-lbl">Bugs fixed</div>
        </div>
        <div class="stat-card">
            <div class="stat-num" style="color: var(--text-2);">@summary.TotalAttempts</div>
            <div class="stat-lbl">Total attempts</div>
        </div>
        <div class="stat-card">
            <div class="stat-num" style="color: var(--text-2);">@summary.ByRepo.Sum(r => r.HintsUsed)</div>
            <div class="stat-lbl">Hints used</div>
        </div>
    </div>

    <h2 class="pane-title">By repo</h2>

    @foreach (var repo in summary.ByRepo)
    {
        var pct = repo.TotalBugs == 0 ? 0 : (int)((double)repo.Solved / repo.TotalBugs * 100);
        <div class="progress-repo">
            <div class="progress-repo-row">
                <h3 class="progress-repo-name">@repo.RepoName</h3>
                <span class="progress-repo-score">@repo.Solved / @repo.TotalBugs solved</span>
            </div>
            <div class="progress-track">
                <div class="progress-fill" style="width: @pct%"></div>
            </div>
            <div class="progress-hints">Hints used: @repo.HintsUsed</div>
        </div>
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private UserProgressSummary? summary;
    private bool _authError;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null) { Nav.NavigateTo("/login", forceLoad: true); return; }
        var state = await AuthState;
        var userId = state.User.GetUserId();
        if (!userId.HasValue) { _authError = true; return; }
        summary = await AttemptService.GetProgressSummaryAsync(userId.Value);
    }
}
