@page "/Error"
@using System.Diagnostics
@layout MainLayout

<PageTitle>Error - Skill Issue</PageTitle>

<div style="text-align: center; padding: 60px 0;">
    <p style="font-family: var(--mono); font-size: 48px; font-weight: 700; color: var(--red); margin: 0 0 12px;">&#9747;</p>
    <p style="font-family: var(--mono); font-size: 14px; color: var(--text-2); margin-bottom: 8px;">An unhandled error occurred.</p>
    @if (ShowRequestId)
    {
        <p style="font-family: var(--mono); font-size: 11px; color: var(--text-3); margin-bottom: 20px;">
            Request ID: <code>@RequestId</code>
        </p>
    }
    <a href="/" class="btn btn-outline-secondary">&#8592; Back to challenges</a>
</div>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
