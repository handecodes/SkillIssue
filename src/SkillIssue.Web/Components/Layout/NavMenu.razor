@using System.Security.Claims
@implements IDisposable
@inject IChallengeService ChallengeService
@inject NavigationManager Nav

<aside class="ide-sidebar" aria-label="File explorer">

    <div class="sidebar-logo" aria-hidden="true">
        <span class="logo-name">SkillIssue</span>
        <span class="logo-ver">v@(AppVersion.Current)</span>
    </div>

    <div class="sidebar-section" aria-hidden="true">Explorer</div>

    <div class="sidebar-tree" role="tree" aria-label="Challenges">
        @if (repos is not null)
        {
            @foreach (var repo in repos)
            {
                <div class="sidebar-folder" role="treeitem" aria-expanded="@(IsOpen(repo.Id) ? "true" : "false")">
                    <button class="sidebar-folder-btn"
                            aria-expanded="@(IsOpen(repo.Id) ? "true" : "false")"
                            aria-label="@ShortName(repo.Name) repository, @(IsOpen(repo.Id) ? "expanded" : "collapsed")"
                            @onclick="() => Toggle(repo.Id)">
                        <span class="folder-arrow @(IsOpen(repo.Id) ? "open" : "")" aria-hidden="true">&#8250;</span>
                        <span class="folder-repo-name">@ShortName(repo.Name)</span>
                    </button>

                    @if (IsOpen(repo.Id))
                    {
                        <div class="sidebar-files" role="group">
                            @foreach (var bug in repo.Bugs.OrderBy(b => b.Difficulty))
                            {
                                <a href="/challenge/@bug.Id"
                                   class="sidebar-file @(ActiveBugId == bug.Id ? "active" : "")"
                                   role="treeitem"
                                   aria-current="@(ActiveBugId == bug.Id ? "page" : null)">
                                    <DifficultyDots Level="bug.Difficulty" ShowLabel="false" />
                                    <span class="file-label">@bug.Title</span>
                                </a>
                            }
                        </div>
                    }
                </div>
            }
        }
    </div>

    <nav class="sidebar-bottom" aria-label="App navigation">
        <NavLink class="sidebar-link" href="/" Match="NavLinkMatch.All">
            <i class="sidebar-icon" aria-hidden="true">&#9633;</i>
            <span>Home</span>
        </NavLink>
        <AuthorizeView>
            <Authorized>
                <NavLink class="sidebar-link" href="/progress">
                    <i class="sidebar-icon" aria-hidden="true">&#9678;</i>
                    <span>My Progress</span>
                </NavLink>
                <div class="sidebar-user">
                    @if (context.User.FindFirstValue("urn:github:avatar") is string avatar)
                    {
                        <img src="@avatar" alt="" class="sidebar-avatar" />
                    }
                    <span class="sidebar-username" aria-hidden="true">
                        @context.User.FindFirstValue(ClaimTypes.Name)
                    </span>
                </div>
                <form method="post" action="/logout" class="logout-form">
                    <AntiforgeryToken />
                    <button type="submit" class="sidebar-link sidebar-logout-btn">
                        <i class="sidebar-icon" aria-hidden="true">&#8592;</i>
                        <span>Log out</span>
                    </button>
                </form>
            </Authorized>
            <NotAuthorized>
                <a class="sidebar-link" href="/login">
                    <i class="sidebar-icon" aria-hidden="true">&#8594;</i>
                    <span>Login with GitHub</span>
                </a>
            </NotAuthorized>
        </AuthorizeView>
    </nav>

</aside>

@code {
    private IReadOnlyList<Repo>? repos;
    private HashSet<int> openFolders = [];

    private int? ActiveBugId
    {
        get
        {
            var path = new Uri(Nav.Uri).AbsolutePath;
            if (path.StartsWith("/challenge/") &&
                int.TryParse(path["/challenge/".Length..], out var id))
                return id;
            return null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        repos = await ChallengeService.GetActiveReposWithBugsAsync();
        // repos is IReadOnlyList<Repo> (non-nullable), so this guard is always true.
        // Kept because repos field is typed nullable to drive the loading-state check in the template.
        if (repos is not null)
            foreach (var r in repos)
                openFolders.Add(r.Id);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        InvokeAsync(StateHasChanged);

    private void Toggle(int repoId)
    {
        if (!openFolders.Remove(repoId))
            openFolders.Add(repoId);
    }

    private bool IsOpen(int id) => openFolders.Contains(id);

    private static string ShortName(string name) =>
        name.Contains('/') ? name.Split('/')[1] : name;

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
