@using System.Security.Claims

<aside class="ide-sidebar">
    <div class="sidebar-logo">
        <span class="logo-name">SkillIssue</span>
        <span class="logo-ver">v1.0.0</span>
    </div>

    <div class="sidebar-section">Explorer</div>

    <nav class="sidebar-nav">
        <NavLink class="sidebar-link" href="/" Match="NavLinkMatch.All">
            <i class="sidebar-icon">&#9633;</i>
            <span>Challenges</span>
        </NavLink>
        <AuthorizeView>
            <Authorized>
                <NavLink class="sidebar-link" href="/progress">
                    <i class="sidebar-icon">&#9678;</i>
                    <span>My Progress</span>
                </NavLink>
            </Authorized>
        </AuthorizeView>
    </nav>

    <div class="sidebar-bottom">
        <AuthorizeView>
            <Authorized>
                <div class="sidebar-user">
                    @if (context.User.FindFirstValue("urn:github:avatar") is string avatar)
                    {
                        <img src="@avatar" alt="" class="sidebar-avatar" />
                    }
                    <span class="sidebar-username">
                        @context.User.FindFirstValue(ClaimTypes.Name)
                    </span>
                </div>
                <a class="sidebar-link" href="/logout">
                    <i class="sidebar-icon">&#8592;</i>
                    <span>Log out</span>
                </a>
            </Authorized>
            <NotAuthorized>
                <a class="sidebar-link" href="/login">
                    <i class="sidebar-icon">&#8594;</i>
                    <span>Login with GitHub</span>
                </a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</aside>
