<nav class="navbar navbar-expand-lg navbar-dark bg-dark px-3">
    <a class="navbar-brand fw-bold" href="/">
        <span class="text-danger">&#10006;</span> Skill Issue
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
        <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navContent">
        <ul class="navbar-nav me-auto">
            <li class="nav-item">
                <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">Challenges</NavLink>
            </li>
            <AuthorizeView>
                <Authorized>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/progress">My Progress</NavLink>
                    </li>
                </Authorized>
            </AuthorizeView>
        </ul>
        <AuthorizeView>
            <Authorized>
                <span class="navbar-text text-light me-3">
                    @if (context.User.FindFirstValue("urn:github:avatar") is string avatar)
                    {
                        <img src="@avatar" alt="avatar" width="24" height="24" class="rounded-circle me-1" />
                    }
                    @context.User.FindFirstValue(System.Security.Claims.ClaimTypes.Name)
                </span>
                <a class="btn btn-outline-light btn-sm" href="/logout">Log out</a>
            </Authorized>
            <NotAuthorized>
                <a class="btn btn-outline-light btn-sm" href="/login">Login with GitHub</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</nav>
