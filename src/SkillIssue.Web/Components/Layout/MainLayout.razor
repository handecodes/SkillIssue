@inherits LayoutComponentBase
@inject NavigationManager Nav

<a href="#main-content" class="skip-link">Skip to content</a>

@if (!IsLandingPage)
{
    <NavMenu />

    <nav class="ide-tabbar" aria-label="Open tabs">
        <a href="/" class="ide-tab @(IsHome ? "active" : "")" aria-current="@(IsHome ? "page" : null)">
            <span class="tab-dot" aria-hidden="true"></span>challenges.ts
        </a>
        <AuthorizeView>
            <Authorized>
                <a href="/progress" class="ide-tab @(IsProgress ? "active" : "")" aria-current="@(IsProgress ? "page" : null)">
                    <span class="tab-dot" aria-hidden="true"></span>progress.sh
                </a>
            </Authorized>
        </AuthorizeView>
        @if (IsChallenge)
        {
            <span class="ide-tab active" role="tab" aria-selected="true">
                <span class="tab-dot" aria-hidden="true"></span>@ChallengeTabName
            </span>
        }
    </nav>
}

<main class="ide-editor @(IsLandingPage ? "ide-editor--landing" : "")" id="main-content">
    @Body
</main>

<div class="ide-statusbar" aria-hidden="true">
    <div class="sb-side">
        <span class="sb-item branch">&#9670; main</span>
        <span class="sb-item">@ActiveTabLabel</span>
    </div>
    <div class="sb-side">
        <span class="sb-item"><a href="https://github.com/handecodes/SkillIssue" target="_blank" rel="noopener noreferrer">Docs</a></span>
        <span class="sb-item">Skill Issue v@AppVersion.Current</span>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">&#x2715;</span>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private bool? _isAuthenticated;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            _isAuthenticated = state.User.Identity?.IsAuthenticated ?? false;
        }
        else
        {
            _isAuthenticated = false;
        }
    }

    private string Path => new Uri(Nav.Uri).AbsolutePath;

    private bool IsHome      => Path == "/";
    private bool IsProgress  => Path.StartsWith("/progress");
    private bool IsChallenge => Path.StartsWith("/challenge/");

    private bool IsLandingPage => IsHome && _isAuthenticated == false;

    private string ChallengeTabName => "bug.cs";

    private string ActiveTabLabel => Path switch {
        "/"                                    => "challenges.ts",
        var p when p.StartsWith("/progress")   => "progress.sh",
        var p when p.StartsWith("/challenge/") => "bug.cs",
        _                                      => "skill-issue"
    };
}
