<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone authoring tool. NOT part of the solution build and NOT referenced
    by the app. Turns manifest.json (source of truth) into DbSeeder Repo rows,
    and verifies that generated rows reproduce the hand-written ones.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SeederGen</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
  </ItemGroup>

</Project>
